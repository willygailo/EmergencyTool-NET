# Environment Variables Template
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/emergencytool
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=emergencytool
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key_here
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4

# SMS Providers
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

GLOBE_API_KEY=your_globe_api_key
GLOBE_API_SECRET=your_globe_api_secret

SMART_API_KEY=your_smart_api_key
SMART_API_SECRET=your_smart_api_secret

# App Config
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Admin
ADMIN_EMAIL=admin@emergencytool.local
ADMIN_PASSWORD=admin123