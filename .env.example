# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=strong_db_password_here
POSTGRES_DB=emergencytool
DATABASE_URL=postgresql://postgres:strong_db_password_here@localhost:5432/emergencytool

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=strong_redis_password_here

# Application Secrets
JWT_SECRET=super_secret_jwt_key_change_me_in_production
SESSION_SECRET=super_secret_session_key

# External APIs
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
NVIDIA_API_KEY=nvapi-your_nvidia_minimax_key

# System
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,exp://*
